DATABASE_URL=postgresql://cactus:cactus@localhost:5433/cactus
POSTGRES_AUTO_START=1
PGVECTOR_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST_PORT=5433
CACTUS_BASE_URL=http://127.0.0.1:8080/v1
CACTUS_MODEL=/home/rpi-ai/.cache/cactus/weights/gemma-4-e2b-it-cq4
CACTUS_AUTO_START=1
NEEDLE_CONFIDENCE_THRESHOLD=0.75
NEEDLE_TOOL_INDEX=.cache/needle-tool-index
EMBED_MODEL=gemma-4-e2b-it-cq4
RECALL_TOP_K=5
BEHAVIOR=terse
SENSORS_ON=1
REMINDER_LOOKAHEAD_MIN=90
REASONING_LEVEL=none
SEARXNG_URL=http://127.0.0.1:8888
WEB_ENABLED=0
TZ_LOCAL=Europe/Berlin
TRIGGER=@
PROACTIVE_GEMMA=1

# Roh-Chat-Retention in Stunden (naechliche Wartung loescht aeltere Nachrichten)
MSG_RETENTION_HOURS=24

# ICS-Export (v4.1): Token für den /ics/{token}.ics Feed
# Wird beim ersten Start von serve.py auto-generiert falls nicht gesetzt
ICS_TOKEN=
ICS_PORT=8765
